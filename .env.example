# Copy to .env and fill in ONE provider key. docker compose reads .env automatically.

# --- data (paths relative to the repository root / container working dir) ---
CORPUS_DIR=./data/corpus
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/veltrix.db

# Today's date as YYYY-MM-DD. Leave empty to use the system date.
APP_TODAY=

# --- LLM: anthropic | openai | gemini ---
LLM_PROVIDER=anthropic
# Optional model override. Defaults: anthropic=claude-opus-5-5, openai=gpt-4.1-mini, gemini=gemini-2.5-flash
LLM_MODEL=
# Per-call timeout in seconds (two LLM calls per message must fit in 30 s)
LLM_TIMEOUT_S=12
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- retrieval ---
# fastembed (local CPU embeddings + BM25) | none (BM25 only)
EMBEDDINGS=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Max corpus tokens per LLM call (tiktoken cl100k_base). The assessment limit is 3000.
CORPUS_TOKEN_BUDGET=3000

# --- demo UI ---
# Employee used when someone signs in to the demo UI with an email that is not in the database.
# Empty = first employee with role "employee".
DEMO_EMPLOYEE_ID=

# --- misc ---
# Port on the host machine (the assessment expects 8000; change only if 8000 is busy locally)
HOST_PORT=8000
LOG_FILE=./logs/app.log
LOG_LEVEL=INFO
# Leave can only be applied for within this calendar year
LEAVE_YEAR=2026
